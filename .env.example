# =============================================================================
# StreamWave — Complete Environment Configuration Template
# Copy this file to backend/.env and frontend/.env respectively.
# NEVER commit real credentials or .env files to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# BACKEND CONFIGURATION (backend/.env)
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=video_platform

# Authentication & Session Security (Phase 3)
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=video_platform_token

# Email & Two-Factor OTP Security (Phase 5)
EMAIL_MODE=development
EMAIL_FROM="StreamWave <noreply@streamwave.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Video & Thumbnail Upload Storage (Phase 7)
MAX_VIDEO_SIZE_MB=500
MAX_THUMBNAIL_SIZE_MB=5
UPLOAD_DIR=uploads
FFMPEG_PATH=

# Multilingual Comment Translation (Phase 13)
TRANSLATION_PROVIDER=development
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
TRANSLATION_TIMEOUT_MS=10000

# Subscriptions (Phase 15)
SUBSCRIPTION_DEMO_MODE=false

# Razorpay Test Payment Gateway (Phase 16)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Real-Time WebRTC Video Calling & Signaling (Phase 23, 24, 27, 28)
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVER=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
CALL_RINGING_TIMEOUT_SECONDS=30

# In-Call Chat & Shared Files (Phase 26)
MAX_CALL_MESSAGE_LENGTH=2000
MAX_CALL_FILE_SIZE_MB=25
CALL_FILE_STORAGE_PATH=uploads/call-files
CALL_CHAT_RATE_LIMIT=20

# -----------------------------------------------------------------------------
# FRONTEND CONFIGURATION (frontend/.env)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
