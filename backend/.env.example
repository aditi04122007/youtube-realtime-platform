PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=video_platform
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=video_platform_token

# Phase 5: Email & Security Configuration
EMAIL_MODE=development
EMAIL_FROM="StreamWave <noreply@streamwave.local>"

# Production SMTP settings (required when EMAIL_MODE=production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# OTP Policy
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Account Lockout Policy
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Phase 7: Video & Media Upload Configuration
MAX_VIDEO_SIZE_MB=500
MAX_THUMBNAIL_SIZE_MB=5
UPLOAD_DIR=uploads
FFMPEG_PATH=

# Phase 13: Translation Configuration
TRANSLATION_PROVIDER=development
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
TRANSLATION_TIMEOUT_MS=10000

# Phase 15: Subscriptions Configuration
SUBSCRIPTION_DEMO_MODE=false

# Phase 16: Razorpay Test Payments Configuration
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Phase 23: Real-Time Video Calling & WebRTC Configuration
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVER=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
CALL_RINGING_TIMEOUT_SECONDS=30

# Phase 26: In-Call Chat & File Sharing Configuration
MAX_CALL_MESSAGE_LENGTH=2000
MAX_CALL_FILE_SIZE_MB=25
CALL_FILE_STORAGE_PATH=uploads/call-files
CALL_CHAT_RATE_LIMIT=20

