{
  "name": "youtube-realtime-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Ready Full-Stack Real-Time Video Platform",
  "main": "server.js",
  "scripts": {
    "start": "node backend/server.js",
    "build": "npm install --prefix backend",
    "postinstall": "npm install --prefix backend",
    "frontend": "npm run dev --prefix frontend",
